@startuml
top to bottom direction

skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho

skinparam class {
    BackgroundColor white
    BorderColor black
    FontColor black
}

abstract class BaseController

class ClientMainController {
    + handleSearch()
    + handleBuyTicket()
}

class DispatcherMainController {
    + handleAddFlight()
    + handleDeleteFlight()
}

class AdminMainController {
    + handleChangeRole()
    + handleBlockUser()
}

class ClientHandler

class AuthService {
    + login()
    + register()
}

class BookingService {
    + bookTicket()
}

class DispatcherService {
    + addFlight()
    + deleteFlight()
}

class AdminService {
    + changeUserRole()
}

class UserDao
class FlightDao
class TicketDao

ClientMainController --|> BaseController
DispatcherMainController --|> BaseController
AdminMainController --|> BaseController

BaseController --> ClientHandler

ClientHandler --> AuthService
ClientHandler --> BookingService
ClientHandler --> DispatcherService
ClientHandler --> AdminService

AuthService --> UserDao
BookingService --> TicketDao
DispatcherService --> FlightDao

@enduml