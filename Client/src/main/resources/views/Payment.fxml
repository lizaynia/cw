<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="25" styleClass="main-container" stylesheets="@/css/style.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.client.controller.PaymentController"
      prefWidth="450" prefHeight="550">
    <padding>
        <Insets bottom="40" left="40" right="40" top="40" />
    </padding>

    <Label text="Подтверждение оплаты" styleClass="title-label" />

    <VBox spacing="15" styleClass="panel" fillWidth="true">
        <Label text="Детали билета" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
        
        <GridPane hgap="10" vgap="10">
            <Label text="Рейс:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="secondary-label" />
            <Label fx:id="flightLabel" text="XY123" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Маршрут:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="secondary-label" />
            <Label fx:id="routeLabel" text="Минск -> Москва" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Место:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="secondary-label" />
            <Label fx:id="seatLabel" text="A1" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-font-weight: bold; -fx-text-fill: #d63384;" />

            <Label text="К оплате:" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="secondary-label" />
            <Label fx:id="priceLabel" text="150.00 BYN" GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        </GridPane>
    </VBox>

    <VBox spacing="10" styleClass="panel">
        <Label text="Реквизиты карты" styleClass="secondary-label" />
        <TextField promptText="0000 0000 0000 0000" styleClass="input-field" />
        <HBox spacing="10">
            <TextField promptText="ММ/ГГ" styleClass="input-field" prefWidth="100" />
            <PasswordField promptText="CVV" styleClass="input-field" prefWidth="80" />
        </HBox>
    </VBox>

    <HBox spacing="15" alignment="CENTER">
        <Button onAction="#handlePay" text="Оплатить" styleClass="button-primary" prefWidth="150" />
        <Button onAction="#handleCancel" text="Отмена" styleClass="button-secondary" prefWidth="100" />
    </HBox>
</VBox>
