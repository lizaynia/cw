<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="0.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.client.controller.LoginController"
      styleClass="main-container" stylesheets="@../css/style.css">
    
    <VBox spacing="20.0" alignment="CENTER" styleClass="panel" maxWidth="400">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
        </padding>

        <Label text="AERO SYSTEM" styleClass="title-label" />

        <VBox spacing="5.0">
            <Label text="Логин" styleClass="secondary-label" />
            <TextField fx:id="loginField" promptText="Введите логин" styleClass="input-field" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Пароль" styleClass="secondary-label" />
            <PasswordField fx:id="passwordField" promptText="Введите пароль" styleClass="input-field" />
        </VBox>

        <Button onAction="#handleLogin" prefWidth="200.0" text="Войти" styleClass="button-primary" />
        
        <Hyperlink onAction="#handleRegister" text="Нет аккаунта? Зарегистрироваться" styleClass="link" />

        <Label fx:id="errorLabel" styleClass="error-label" />
    </VBox>
</VBox>
