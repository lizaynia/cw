<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.client.controller.DispatcherMainController" styleClass="main-container" stylesheets="@/css/style.css">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Панель диспетчера" styleClass="title-label"/>

    <TableView fx:id="flightsTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="flightNumberColumn" text="Рейс" prefWidth="80"/>
            <TableColumn fx:id="departureColumn" text="Откуда" prefWidth="120"/>
            <TableColumn fx:id="destinationColumn" text="Куда" prefWidth="120"/>
            <TableColumn fx:id="timeColumn" text="Время" prefWidth="150"/>
        </columns>
    </TableView>

    <HBox spacing="15" alignment="CENTER">
        <Button onAction="#handleAddFlight" text="Добавить рейс" styleClass="button-primary"/>
        <Button onAction="#handleEditFlight" text="Редактировать рейс" styleClass="button-secondary"/>
        <Button onAction="#handleDeleteFlight" text="Удалить рейс" styleClass="button-secondary"/>
        <Button onAction="#handleLogout" text="Выйти" styleClass="button-secondary"/>
    </HBox>
</VBox>