<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" styleClass="main-container" stylesheets="@../css/style.css" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.client.controller.AddFlightController"
      prefWidth="400">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label text="Добавление рейса" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;" />

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
        </columnConstraints>
        
        <Label text="Номер рейса:" textFill="#b2b2b2" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="flightNumberField" promptText="например, MSQ-123" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Город отправления:" textFill="#b2b2b2" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="departureCityField" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Город прибытия:" textFill="#b2b2b2" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="arrivalCityField" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Дата:" textFill="#b2b2b2" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <DatePicker fx:id="datePicker" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Время (HH:mm):" textFill="#b2b2b2" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="timeField" promptText="12:00" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Label text="Самолет:" textFill="#b2b2b2" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <ComboBox fx:id="airplaneComboBox" prefWidth="200" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="5" />
    </GridPane>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button onAction="#handleCancel" text="Отмена" style="-fx-background-color: #444; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;" />
        <Button onAction="#handleSave" text="Сохранить" styleClass="login-button" />
    </HBox>
</VBox>
