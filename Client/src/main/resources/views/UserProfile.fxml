<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" styleClass="main-container" stylesheets="@/css/style.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.client.controller.UserProfileController"
      prefWidth="850" prefHeight="650">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Личный кабинет" styleClass="title-label" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleBack" text="← На главную" styleClass="button-secondary" />
    </HBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 8;">
        <tabs>
            <!-- Вкладка 1: Мои билеты -->
            <Tab text="Мои билеты">
                <VBox spacing="15">
                    <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>

                    <Label text="Активные билеты" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <TableView fx:id="activeTicketsTable" prefHeight="200" styleClass="table-view">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="activeFlightColumn" text="Рейс" prefWidth="100" />
                            <TableColumn fx:id="activeRouteColumn" text="Маршрут" prefWidth="250" />
                            <TableColumn fx:id="activeSeatColumn" text="Место" prefWidth="80" />
                            <TableColumn fx:id="activeStatusColumn" text="Статус" prefWidth="100" />
                        </columns>
                    </TableView>

                    <Separator />

                    <Label text="История поездок" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <TableView fx:id="historyTicketsTable" prefHeight="200" styleClass="table-view">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="histFlightColumn" text="Рейс" prefWidth="100" />
                            <TableColumn fx:id="histRouteColumn" text="Маршрут" prefWidth="250" />
                            <TableColumn fx:id="histDateColumn" text="Дата вылета" prefWidth="150" />
                            <TableColumn fx:id="histStatusColumn" text="Статус" prefWidth="100" />
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- Вкладка 2: Профиль -->
            <Tab text="Профиль">
                <VBox spacing="20" alignment="TOP_CENTER">
                    <padding><Insets bottom="30" left="80" right="80" top="30" /></padding>

                    <VBox spacing="15" styleClass="panel">
                        <Label text="Личные данные" style="-fx-font-weight: bold; -fx-font-size: 16px;" />

                        <GridPane hgap="15" vgap="15">
                            <Label text="Логин:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="secondary-label" />
                            <TextField fx:id="loginField" editable="false" styleClass="input-field"
                                       GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="300" />

                            <Label text="ФИО:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="secondary-label" />
                            <TextField fx:id="fullNameField" promptText="Введите ваше имя и фамилию"
                                       styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <Label text="Номер паспорта:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="secondary-label" />
                            <TextField fx:id="passportField" promptText="Введите номер паспорта"
                                       styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        </GridPane>

                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <Button onAction="#handleUpdateProfile" text="Сохранить изменения" styleClass="button-primary" />
                        </HBox>
                    </VBox>

                    <VBox spacing="15" styleClass="panel">
                        <Label text="Смена пароля" style="-fx-font-weight: bold; -fx-font-size: 16px;" />

                        <PasswordField fx:id="newPasswordField" promptText="Новый пароль" styleClass="input-field" />
                        <PasswordField fx:id="confirmPasswordField" promptText="Подтвердите новый пароль" styleClass="input-field" />

                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <Button onAction="#handleChangePassword" text="Сменить пароль" styleClass="button-secondary" />
                        </HBox>
                    </VBox>
                </VBox>
            </Tab>
        </tabs>
    </TabPane>
</VBox>