<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.client.controller.AdminMainController" styleClass="main-container" stylesheets="@../css/style.css">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Панель администратора" styleClass="title-label"/>

    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
            <TableColumn fx:id="loginColumn" text="Логин" prefWidth="150"/>
            <TableColumn fx:id="roleColumn" text="Роль" prefWidth="100"/>
            <TableColumn fx:id="statusColumn" text="Статус" prefWidth="100"/>
        </columns>
    </TableView>

    <HBox spacing="15" alignment="CENTER">
        <Button text="Изменить роль" styleClass="button-primary"/>
        <Button text="Заблокировать" styleClass="button-secondary"/>
        <Button text="Выйти" onAction="#handleLogout" styleClass="button-secondary"/>
    </HBox>
</VBox>
